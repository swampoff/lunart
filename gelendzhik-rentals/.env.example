# Порт API. В dev фронтенд на 5173 проксирует /api сюда.
API_PORT=3001
PORT=3001

# Публичный адрес сайта — на него платёжный провайдер возвращает гостя после оплаты.
PUBLIC_URL=http://localhost:5173

# Файл базы данных SQLite.
DATABASE_PATH=data/rentals.db

# mock — встроенная тестовая оплата без внешних ключей (по умолчанию)
# yookassa — боевой эквайринг ЮKassa
PAYMENT_PROVIDER=mock

# Ключи из личного кабинета ЮKassa (Настройки → Ключи API).
# Секретный ключ хранится только на сервере и никогда не попадает в браузер.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
